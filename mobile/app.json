{
  "expo": {
    "name": "HERMAPS",
    "slug": "hermaps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermaps.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rota hesaplamak ve seyir sırasında yönlendirme yapmak için konumunuz kullanılır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f242a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.hermaps.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rota hesaplamak ve seyir sırasında yönlendirme yapmak için konumunuz kullanılır."
        }
      ],
      [
        "expo-pip",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#141a21"
        }
      ]
    ]
  }
}
